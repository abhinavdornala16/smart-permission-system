# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (Dhondi Smart Permission & Faculty System)
# ==============================================================================

# --- Application Environment ---
# Set to 'development' for local SQLite, 'production' for cloud deployment
FLASK_ENV=development
PORT=5000

# --- Security Keys (Generate strong random secrets for production) ---
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# --- Database Connection ---
# Local SQLite (Development):
DATABASE_URL=sqlite:///smart_permission.db
# Cloud PostgreSQL (Supabase):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.uihcsbftxjzsrlpvmqfe.supabase.co:5432/postgres
# Or Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.uihcsbftxjzsrlpvmqfe:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- JWT Token Lifetimes (in seconds) ---
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# --- File Uploads ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# --- Allowed CORS Origins (Comma-separated list of deployed frontend URLs) ---
# Local:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Production Example:
# CORS_ORIGINS=https://dhondi-permission.vercel.app,https://dhondi-permission.onrender.com

# --- QR Verification Base URL (Public URL that guard/scanner accesses) ---
# Local:
QR_VERIFICATION_BASE_URL=http://localhost:5173/verify-pass
# Production Example:
# QR_VERIFICATION_BASE_URL=https://dhondi-permission.vercel.app/verify-pass

